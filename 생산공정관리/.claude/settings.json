{
  "permissions": {
    "allow": [
      "Bash(python*)",
      "Bash(streamlit*)",
      "Bash(taskkill*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(del /f*)",
      "Bash(drop*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m py_compile d:/AI/생산공정관리/scripts/app.py && echo [OK] app.py 문법 검사 통과 || echo [ERROR] app.py 문법 오류 - 수정 필요"
          }
        ]
      }
    ]
  }
}
