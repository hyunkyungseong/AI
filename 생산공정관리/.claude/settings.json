{
  "permissions": {
    "allow": [
      "Bash(python*)",
      "Bash(streamlit*)",
      "Bash(taskkill*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(del /f*)",
      "Bash(drop*)",
      "Read(../*)  ",
      "Edit(../*)  ",
      "Write(../*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m py_compile scripts/app.py scripts/preprocess.py scripts/init_db.py && echo [OK] scripts 문법 검사 통과 || echo [ERROR] 문법 오류 - 수정 필요"
          }
        ]
      }
    ]
  }
}
